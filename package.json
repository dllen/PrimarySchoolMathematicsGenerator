{
  "name": "PrimarySchoolMathematicsGenerator",
  "version": "1.0.0",
  "type": "module",
  "description": "Primary school math problem generation app",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "vite build && cp .nojekyll dist/",
    "build:library": "node scripts/build-library.mjs",
    "preview": "vite preview",
