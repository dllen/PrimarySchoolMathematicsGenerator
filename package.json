    "gh-pages": "^6.0.0",
    "html2canvas-pro": "^1.5.8",
    "html2pdf.js": "^0.14.0",
    "vite": "^4.4.5",
    "vue": "^3.3.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.6",
    "cypress": "^15.4.0",
    "dexie": "^4.2.1",
    "fake-indexeddb": "^6.2.3",
    "gh-pages": "^6.0.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^4.4.5",
